{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "text": "${UpperLimit}",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "horizontalAlignment": "Right",
      "$when": "${$host.widgetSize==\"medium\"}"
    },
    {
      "type": "Image",
      "url": "${ChartURL}",
      "horizontalAlignment": "Center",
      "$when": "${$host.widgetSize==\"medium\"}",
      "spacing": "small"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "{{NetworkActivityTemplate_Sent}}",
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "{{NetworkActivityTemplate_Recv}}",
              "horizontalAlignment": "Right",
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${SentSpeed}",
              "size": "Large",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${RecvSpeed}",
              "wrap": true,
              "horizontalAlignment": "Right",
              "size": "Large",
              "weight": "Bolder",
              "color": "Default"
            }
          ]
        }
      ]
    }
  ]
}