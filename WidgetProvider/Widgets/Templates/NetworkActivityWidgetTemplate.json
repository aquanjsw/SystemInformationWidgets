{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "items": [
            {
              "type": "TextBlock",
              "text": "{{NetworkActivityTemplate_Throughput}}",
              "wrap": true,
              "isSubtle": true,
              "size": "Small",
              "$when": "${$host.widgetSize==\"medium\"}"
            }
          ]
        },
        {
          "type": "Column",
          "items": [
            {
              "type": "TextBlock",
              "text": "${UpperLimit}",
              "wrap": true,
              "isSubtle": true,
              "size": "Small",
              "horizontalAlignment": "Right",
              "$when": "${$host.widgetSize==\"medium\"}"
            }
          ]
        }
      ]
    },
    {
      "type": "Image",
      "url": "${ChartUrl}",
      "horizontalAlignment": "Center",
      "$when": "${$host.widgetSize==\"medium\"}",
      "spacing": "None"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "${LegendWidth}",
          "items": [
            {
              "type": "Image",
              "url": "${SentLegendUrl}",
              "horizontalAlignment": "Left",
              "spacing": "None"
            }
          ],
          "verticalContentAlignment": "center",
          "spacing": "None",
          "$when": "${$host.widgetSize==\"medium\"}"
        },
        {
          "type": "Column",
          "width": "stretch",
          "spacing": "none",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "{{NetworkActivityTemplate_Sent}}",
                      "style": "heading",
                      "isSubtle": true,
                      "size": "Default",
                      "weight": "Default"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "{{NetworkActivityTemplate_Recv}}",
                      "horizontalAlignment": "Right",
                      "style": "heading",
                      "isSubtle": true,
                      "size": "Default",
                      "weight": "Default"
                    }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${SentSpeed}",
                      "size": "Large",
                      "weight": "Bolder"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${RecvSpeed}",
                      "horizontalAlignment": "Right",
                      "size": "Large",
                      "weight": "Bolder",
                      "color": "Default"
                    }
                  ]
                }
              ],
              "spacing": "none"
            }
          ]
        },
        {
          "type": "Column",
          "width": "${LegendWidth}",
          "items": [
            {
              "type": "Image",
              "url": "${RecvLegendUrl}",
              "horizontalAlignment": "Right",
              "spacing": "None"
            }
          ],
          "verticalContentAlignment": "center",
          "$when": "${$host.widgetSize==\"medium\"}",
          "spacing": "none"
        }
      ],
      "spacing": "small"
    }
  ]
}