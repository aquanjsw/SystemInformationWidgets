{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Send",
              "wrap": true,
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Receive",
              "wrap": true,
              "horizontalAlignment": "Right",
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${sentSpeed}",
              "size": "Large",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${recvSpeed}",
              "wrap": true,
              "horizontalAlignment": "Right",
              "size": "Large",
              "weight": "Bolder",
              "color": "Default"
            }
          ]
        }
      ]
    }
  ]
}