{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Send",
              "wrap": true,
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Receive",
              "wrap": true,
              "horizontalAlignment": "Right",
              "style": "heading",
              "isSubtle": true,
              "size": "Default",
              "weight": "Default"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${sentSpeed}",
              "size": "Large",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${recvSpeed}",
              "wrap": true,
              "horizontalAlignment": "Right",
              "size": "Large",
              "weight": "Bolder",
              "color": "Default"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Default Interface",
      "wrap": true,
      "isSubtle": true,
      "$when": "${$host.widgetSize==\"medium\"}"
    },
    {
      "type": "TextBlock",
      "text": "${interfaceName}",
      "wrap": true,
      "height": "stretch",
      "weight": "Default",
      "$when": "${$host.widgetSize==\"medium\"}"
    },
    {
      "type": "ActionSet",
      "actions": [
        {
          "type": "Action.Execute",
          "title": "Redetect",
          "verb": "redetect",
          "isEnabled": "${isRedetectEnabled}",
          "tooltip": "Redetect default interface"
        }
      ],
      "horizontalAlignment": "Right",
      "$when": "${$host.widgetSize==\"medium\"}"
    }
  ]
}